{
  "attribution": {
    "sessionUrl": false
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.delphi/paths.sh\" >> \"$CLAUDE_ENV_FILE\""
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "delphi": {
      "source": {
        "source": "github",
        "repo": "Northeastern-Electric-Racing/Delphi"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "app@delphi": true,
    "argos@delphi": true
  }
}
